---
// 10. Contact & Booking
import Layout from "../layouts/Layout.astro";
import Preloader from "../components/Preloader.astro";
import Header from "../components/Header.astro";
import Overlays from "../components/Overlays.astro";
import Footer from "../components/Footer.astro";
import PageHero from "../components/PageHero.astro";
import SectionTitle from "../components/SectionTitle.astro";
import Icon from "../components/Icon.astro";
import { site, whatsappLink, telHref, url } from "../data/site";
import { contact } from "../data/pages";

const cards = [
  { icon: "pin", label: "Address", lines: [{ text: site.address, href: contact.mapLink, external: true }] },
  {
    icon: "phone", label: "Telephone",
    lines: [
      ...[site.phone, site.phone2, site.phone3].map((n) => ({ text: `Front desk: ${n}`, href: telHref(n) })),
      { text: `Reservations: ${site.reservationPhone}`, href: telHref(site.reservationPhone) },
    ],
  },
  {
    icon: "whatsapp", label: "Mobile / WhatsApp",
    lines: [
      { text: `Front desk: ${site.mobile}`, href: whatsappLink(["I have a question about Yugharling Resort."]), external: true },
      { text: `Reservations: ${site.reservationMobile}`, href: whatsappLink(["I would like to make a reservation."], site.reservationWhatsapp), external: true },
    ],
  },
  { icon: "mail", label: "Email", lines: [site.email, site.email2].map((e) => ({ text: e, href: `mailto:${e}` })) },
  { icon: "view", label: "Website", lines: [{ text: site.website, href: url("/") }] },
];
const delays = ["", "reveal-d1", "reveal-d2", "reveal-d3", ""];
---

<Layout title={`Contact Us | ${site.name}`} description="Contact Yugharling Resort & Wellness Spa in Chamkhar, Bumthang: phone, WhatsApp, email and directions for reservations, group bookings and events.">
  <Preloader />
  <Header />
  <Overlays />

  <main>
    <PageHero
      image={url("/images/yugharling/reception.jpg")}
      script="get in"
      title="Touch"
      crumbs={[{ label: "Contact Us" }]}
      cta={{ href: "#contact-details", label: "Contact Us" }}
    />

    <section class="section section--mist" id="contact-details">
      <div class="container">
        <SectionTitle label="Contact & Booking" thin={site.name} title="Plan Your Stay in Bumthang" center class="reveal">
          <p>{contact.intro}</p>
        </SectionTitle>
        <div class="contact-cards">
          {cards.map((c, i) => (
            <div class:list={["contact-card reveal", delays[i]]}>
              <Icon name={c.icon} class="contact-card__icon" />
              <span class="label">{c.label}</span>
              {c.lines.map((l) => (
                <a href={l.href} {...(l.external ? { target: "_blank", rel: "noopener" } : {})}>{l.text}</a>
              ))}
            </div>
          ))}
        </div>
      </div>
    </section>

    <section class="section">
      <div class="container contact-grid">
        <div class="contact-map reveal">
          <iframe src={contact.mapEmbed} title={`Map — ${site.name}, Bumthang`} loading="lazy" referrerpolicy="no-referrer-when-downgrade"></iframe>
        </div>
        <div class="reveal reveal-d1">
          <SectionTitle label="Contact Details" thin="Chamkhar, Bumthang" title="Reservations & enquiries">
            <p>{contact.note}</p>
          </SectionTitle>
          <div class="contact-actions">
            <a href={url("/booking/")} class="btn btn--teal">Book Your Stay</a>
            <a href={contact.mapLink} class="btn btn--outlined" target="_blank" rel="noopener">Get Directions</a>
          </div>
        </div>
      </div>
    </section>
  </main>

  <Footer />
</Layout>
