---
import Layout from "../layouts/Layout.astro";
import Preloader from "../components/Preloader.astro";
import Header from "../components/Header.astro";
import Overlays from "../components/Overlays.astro";
import Hero from "../components/Hero.astro";
import BookingBar from "../components/BookingBar.astro";
import About from "../components/About.astro";
import Amenities from "../components/Amenities.astro";
import Rooms from "../components/Rooms.astro";
import Comfort from "../components/Comfort.astro";
import Explore from "../components/Explore.astro";
import Gallery from "../components/Gallery.astro";
import Footer from "../components/Footer.astro";
---

<Layout description="A peaceful retreat in Chamkhar, Bumthang, where Bhutanese tradition, warm hospitality and modern comfort come together, beside the Chamkhar Chhu.">
  <Preloader />
  <Header />
  <Overlays />

  <main>
    <Hero />
    <BookingBar variant="hero" />
    <About />
    <Amenities />
    <Rooms />
    <Comfort />
    <Explore />
    <Gallery />
  </main>

  <Footer />
</Layout>
