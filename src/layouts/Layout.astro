---
import "../styles/global.css";
import IconSprite from "../components/IconSprite.astro";
import { site } from "../data/site";

interface Props {
  title?: string;
}
const { title = `${site.name} | Bumthang, Bhutan` } = Astro.props;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={site.description} />
    <meta name="theme-color" content="#1b2240" />
    <link rel="icon" type="image/png" href="/favicon.png" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Cormorant+Upright:wght@300;400;500;600;700&family=Inconsolata:wght@300;400;500;600&family=Roboto:wght@300;400;500&display=swap" rel="stylesheet" />
  </head>
  <body class="is-locked">
    <IconSprite />
    <slot />
    <script src="../scripts/main.js"></script>
  </body>
</html>
