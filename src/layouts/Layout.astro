---
// Fonts are served from this site (Latin only, just the weights in use) to skip two connections to Google
import "@fontsource/cormorant-upright/latin-400.css";
import "@fontsource/cormorant-upright/latin-500.css";
import "@fontsource/cormorant-upright/latin-600.css";
import "@fontsource/cormorant-upright/latin-700.css";
import "@fontsource/inconsolata/latin-300.css";
import "@fontsource/inconsolata/latin-400.css";
import "@fontsource/inconsolata/latin-500.css";
import "@fontsource/roboto/latin-300.css";
import "@fontsource/roboto/latin-400.css";
import "@fontsource/roboto/latin-500.css";
import "../styles/global.css";
import IconSprite from "../components/IconSprite.astro";
import { site, url, img, rooms, socials } from "../data/site";

interface Props {
  title?: string;
  description?: string;
  /** Social preview image (root-relative, base included) */
  image?: string;
}
const { title = `${site.name} | Bumthang, Bhutan`, description = site.description, image = img("resort-view.jpg") } = Astro.props;
const canonical = new URL(Astro.url.pathname, Astro.site);
const ogImage = new URL(image, Astro.site);

// Hotel details for search engines, on the home page only
const isHome = Astro.url.pathname === url("/") || Astro.url.pathname === `${url("/")}/`;
const rates = rooms.map((r) => r.rate);
const hotelSchema = {
  "@context": "https://schema.org",
  "@type": "Resort",
  name: site.name,
  description: site.description,
  url: new URL(url("/"), Astro.site).href,
  image: ogImage.href,
  telephone: site.phoneHref.replace("tel:", ""),
  email: site.email,
  address: {
    "@type": "PostalAddress",
    postOfficeBoxNumber: "101",
    addressLocality: "Chamkhar",
    addressRegion: "Bumthang",
    addressCountry: "BT",
  },
  priceRange: `Nu. ${Math.min(...rates).toLocaleString("en-US")} – Nu. ${Math.max(...rates).toLocaleString("en-US")} per night`,
  sameAs: socials.map((s) => s.href).filter(Boolean),
};
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <link rel="sitemap" href={url("/sitemap-index.xml")} />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={site.name} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="theme-color" content="#1b2240" />
    {isHome && <script type="application/ld+json" set:html={JSON.stringify(hotelSchema)} />}
    <link rel="icon" type="image/png" href={url("/favicon.png")} />
    <!-- Without JavaScript: no hidden reveal blocks -->
    <noscript><style>.reveal { opacity: 1; transform: none; }</style></noscript>
  </head>
  <body>
    <IconSprite />
    <slot />
    <script src="../scripts/main.js"></script>
  </body>
</html>
