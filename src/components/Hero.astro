---
import Icon from "./Icon.astro";
import { heroSlides, url } from "../data/site";
---

<link rel="preload" as="image" href={heroSlides[0].image} fetchpriority="high" />
<section class="hero" id="home">
  <div class="hero__side-label">Yugharling · Bumthang · Bhutan</div>

  {heroSlides.map((s, i) => (
    <div class:list={["hero__slide", { "is-active": i === 0, "hero__slide--top": s.align === "top", "hero__slide--sky": s.sky === "night", "hero__slide--bright": s.sky === "bright" }]}>
      {i === 0
        ? <div class="hero__bg" style={`background-image:url('${s.image}')`}></div>
        : <div class="hero__bg" data-bg={s.image}></div>}
      <div class="container hero__content">
        <span class="hero__script anim">{s.script}</span>
        {i === 0 ? <h1 class="hero__title anim">{s.title}</h1> : <h2 class="hero__title anim">{s.title}</h2>}
        <p class="hero__text anim">{s.text}</p>
        <div class="hero__actions anim">
          <a href={url("/accommodation/")} class="btn btn--light">Explore Our Rooms</a>
          <a href={url("/booking/")} class="btn btn--teal">Book Your Stay</a>
        </div>
      </div>
    </div>
  ))}

  <div class="hero__pagination" role="group" aria-label="Slides">
    {heroSlides.map((_, i) => (
      <button class:list={["hero__dot", { "is-active": i === 0 }]} aria-label={`Slide ${i + 1}`} aria-current={i === 0 ? "true" : undefined}>{String(i + 1).padStart(2, "0")}</button>
    ))}
  </div>
  <div class="hero__arrows">
    <button class="hero__arrow js-hero-prev" aria-label="Previous slide"><Icon name="arrow-l" /></button>
    <button class="hero__arrow js-hero-next" aria-label="Next slide"><Icon name="arrow-r" /></button>
  </div>
  <div class="hero__progress" id="heroProgress"></div>
</section>
