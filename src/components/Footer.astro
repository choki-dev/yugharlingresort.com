---
import Icon from "./Icon.astro";
import Logo from "./Logo.astro";
import Socials from "./Socials.astro";
import { site, telHref, whatsappLink, url } from "../data/site";

const links = [
  { href: url("/about/"), label: "About Us" },
  { href: url("/accommodation/"), label: "Rooms & Suites" },
  { href: url("/facilities/"), label: "Facilities" },
  { href: url("/sustainability/"), label: "Sustainability" },
  { href: url("/things-to-do/"), label: "Experience Bumthang" },
  { href: url("/booking/"), label: "Booking" },
  { href: url("/contact/"), label: "Contact" },
];
const year = new Date().getFullYear();
---

<footer class="site-footer" id="contact">
  <div class="footer-top">
    <div class="container footer-grid">
      <div class="footer-brand">
        <div class="footer-brand__head">
          <Logo />
          <div class="footer-brand__name">
            <strong>Yugharling</strong>
            <span>Resort &amp; Wellness Spa</span>
          </div>
        </div>
        <p class="footer-brand__tagline">{site.tagline}</p>
        <Socials />
      </div>
      <div>
        <h5>The Resort</h5>
        <ul class="footer-links">
          {links.map((l) => <li><a href={l.href}>{l.label}</a></li>)}
        </ul>
      </div>
      <div>
        <h5>Get In Touch</h5>
        <ul class="footer-contact">
          <li><Icon name="phone" /><a href={site.phoneHref}>Front desk: {site.phone}</a></li>
          <li><Icon name="whatsapp" /><a href={whatsappLink(["I have a question about Yugharling Resort."])} target="_blank" rel="noopener">Front desk: {site.mobile}</a></li>
          <li><Icon name="phone" /><a href={telHref(site.reservationPhone)}>Reservations: {site.reservationPhone}</a></li>
          <li><Icon name="whatsapp" /><a href={whatsappLink(["I would like to make a reservation."], site.reservationWhatsapp)} target="_blank" rel="noopener">Reservations: {site.reservationMobile}</a></li>
          <li><Icon name="mail" /><a href={`mailto:${site.email}`}>{site.email}</a></li>
          <li><Icon name="pin" /><span>{site.address}</span></li>
        </ul>
      </div>
    </div>
  </div>
  <div class="footer-bottom">
    <div class="container footer-bottom__inner">
      <span>© <span id="year">{year}</span> {site.name}</span>
      <span class="footer-credit">Website Designed And Developed by <a href="https://abit.bt" target="_blank" rel="noopener">aBit Private Limited</a></span>
    </div>
  </div>
</footer>
