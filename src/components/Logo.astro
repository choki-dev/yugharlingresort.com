---
// Turquoise monogram; it reads on both the navy header and the white sticky header,
// so one image serves every background.
import { url } from "../data/site";
interface Props {
  label?: string;
}
const { label = "Yugharling Resort — home" } = Astro.props;
---

<a href={url("/")} class="logo" aria-label={label}>
  <img src={url("/images/logo.webp")} alt="Yugharling Resort" width="315" height="300" />
</a>
