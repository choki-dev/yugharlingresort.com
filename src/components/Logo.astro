---
// variant "light" = white lettering for dark backgrounds, "color" = navy lettering.
// "auto" renders both so CSS can swap them (mobile bar changes background on scroll).
import { url } from "../data/site";
interface Props {
  variant?: "light" | "color" | "auto";
  label?: string;
}
const { variant = "light", label = "Yugharling Resort — home" } = Astro.props;
---

<a href={url("/")} class:list={["logo", { "logo--color": variant === "color" }]} aria-label={label}>
  {(variant === "light" || variant === "auto") && (
    <img class="logo__light" src={url("/images/logo-light.png")} alt="Yugharling Resort" width="150" height="100" />
  )}
  {(variant === "color" || variant === "auto") && (
    <img class="logo__color" src={url("/images/logo-color.png")} alt="Yugharling Resort" width="150" height="100" />
  )}
</a>
