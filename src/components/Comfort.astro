---
// Home "Comfort by Nature": a short reference that links to the Sustainability page
import SectionTitle from "./SectionTitle.astro";
import { comfort, url } from "../data/site";
---

<section class="section" id="comfort">
  <div class="container about__grid">
    <div class="about__media reveal">
      <img class="img-main" src={comfort.image} alt="Yugharling Resort in the Bumthang Valley" loading="lazy" />
      <img class="img-small" src={comfort.imageSmall} alt="Resort garden and terrace" loading="lazy" />
    </div>
    <div class="about__content">
      <SectionTitle label="Sustainability" thin="Bhutanese tradition, modern efficiency" title="Comfort by Nature" class="reveal">
        <p>{comfort.text}</p>
      </SectionTitle>
      <a href={url("/sustainability/")} class="btn btn--outlined reveal">Our Sustainability</a>
    </div>
  </div>
</section>
